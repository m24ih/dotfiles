{
    "apps": [
        {
            "image-path": "desktop.png",
            "name": "Desktop",
            "prep-cmd": [
                {
                    "do": "sh -c \"killall -q krfb-virtualmonitor || true ; kscreen-doctor output.eDP-1.mode.1920x1080@144 || true\""
                }
            ]
        },
        {
            "auto-detach": true,
            "cmd": "",
            "elevated": false,
            "exclude-global-prep-cmd": false,
            "exit-timeout": 5,
            "image-path": "/home/melih/Pictures/TabS9+.png",
            "name": "Galaxy Tab Second Screen",
            "prep-cmd": [
                {
                    "do": "sh -c \"killall -q krfb-virtualmonitor || true ; sleep 0.5 ; krfb-virtualmonitor --name 'TabletEkran' --resolution ${SUNSHINE_CLIENT_WIDTH}x${SUNSHINE_CLIENT_HEIGHT} --password '123456' --port 5900 & sleep 1.5 ; kscreen-doctor output.Virtual-TabletEkran.position.1920,0 output.Virtual-TabletEkran.mode.${SUNSHINE_CLIENT_WIDTH}x${SUNSHINE_CLIENT_HEIGHT}@${SUNSHINE_CLIENT_FPS} output.Virtual-TabletEkran.scale.1.5 || true\"",
                    "undo": "sh -c \"killall -q krfb-virtualmonitor || true\""
                }
            ],
            "wait-all": true
        },
        {
            "auto-detach": true,
            "exclude-global-prep-cmd": false,
            "exit-timeout": 5,
            "image-path": "desktop-alt.png",
            "name": "Low Res Desktop",
            "prep-cmd": [
                {
                    "do": "sh -c \"killall -q krfb-virtualmonitor || true ; kscreen-doctor output.eDP-1.mode.1280x720@60 || true\"",
                    "undo": "sh -c \"kscreen-doctor output.eDP-1.mode.1920x1080@144 || true\""
                }
            ],
            "wait-all": true
        },
        {
            "detached": [
                "setsid steam steam://open/bigpicture"
            ],
            "image-path": "steam.png",
            "name": "Steam Big Picture",
            "prep-cmd": [
                {
                    "do": "sh -c \"killall -q krfb-virtualmonitor || true\"",
                    "undo": "setsid steam steam://close/bigpicture"
                }
            ]
        }
    ],
    "env": {
        "PATH": "$(PATH):$(HOME)/.local/bin"
    }
}