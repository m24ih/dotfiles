// ┌────────────────────────────────────────────────────────────────────────────┐
// │                            LAYOUT SETTINGS                                 │
// └────────────────────────────────────────────────────────────────────────────┘
// Documentation: https://github.com/YaLTeR/niri/wiki/Configuration:-Layout

layout {
    // ─── Geometry ───
    gaps 4
    center-focused-column "never"
    background-color "transparent"

    // ─── Preset Dimensions ───
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    // ─── Focus & Visual Cues ───
    border {
        off
        width 2
    }

    focus-ring {
        width 2
    }

    // ─── Window Decorations ───
    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {
    }
}

// ─── Overview Configuration ───
overview {
    workspace-shadow {
        off
    }
}

