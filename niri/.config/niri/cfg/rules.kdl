// ┌────────────────────────────────────────────────────────────────────────────┐
// │                            WINDOW RULES SETTINGS                           │
// └────────────────────────────────────────────────────────────────────────────┘
// Documentation: https://github.com/YaLTeR/niri/wiki/Configuration:-Window-Rules

// ─── Global Window Geometry ───
window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
}

// ─── Security & Privacy ───
// Hide sensitive apps (Proton Pass) from screen capture.
window-rule {
    match app-id=r#"^proton-pass.*$"#
    match title=r#"^Proton Pass.*$"#
    block-out-from "screen-capture"
}

// ─── Gaming & Performance ───
// Optimized for RTX 4060 / 144Hz displays.
window-rule {
    match app-id=r#"^cs2$"#
    match app-id=r#"^gamescope$"#
    match app-id=r#"^steam_app_.*$"#
    
    variable-refresh-rate true
    open-fullscreen true
}

window-rule {
    match app-id="^mpv$"
    variable-refresh-rate true
}

// ─── Productivity & Styling ───
window-rule {
    match app-id=r#"^obsidian$"#
    open-maximized true
}

// Applications with blur and specific decorations.
window-rule {
    match app-id=r#"^org\.gnome\.Nautilus$"#
    match app-id=r#"^kitty$"#
    match app-id=r#"^com\.mitchellh\.ghostty$"#
    match app-id=r#"^ghostty$"#
    match app-id=r#"^obsidian$"#
    
    background-effect {
        blur true
        xray false
    }
    
    popups {
        geometry-corner-radius 12
        background-effect {
            blur true
        }
    }
}

// Disable solid border background for modern terminals & browsers
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    match app-id="Alacritty"
    match app-id="zen"
    match app-id="com.mitchellh.ghostty"
    match app-id="ghostty"
    match app-id="kitty"
    draw-border-with-background false
}

// Floating rules (Firefox PiP & Zoom).
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
    default-floating-position x=32 y=32 relative-to="bottom-right"
}

window-rule {
    match app-id="zoom"
    open-floating true
}

// Standard utilities & GNOME floating rules
window-rule {
    match app-id=r#"^gnome-control-center$"#
    match app-id=r#"^pavucontrol$"#
    match app-id=r#"^nm-connection-editor$"#
    default-column-width { proportion 0.5; }
    open-floating false
}

window-rule {
    match app-id=r#"^org\.gnome\.Calculator$"#
    match app-id=r#"^gnome-calculator$"#
    match app-id=r#"^galculator$"#
    match app-id=r#"^blueman-manager$"#
    match app-id=r#"^xdg-desktop-portal$"#
    open-floating true
}

// Work around WezTerm configure bug
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// ─── Steam Specifics ───
window-rule {
    match app-id="steam"
    exclude title=r#"^[Ss]team$"#
    open-floating true
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

// Floating Noctalia settings window.
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// ┌────────────────────────────────────────────────────────────────────────────┐
// │                             LAYER RULES                                    │
// └────────────────────────────────────────────────────────────────────────────┘
// Documentation: https://github.com/YaLTeR/niri/wiki/Configuration:-Layer-Rules

// ─── Noctalia Shell Layers ───
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="^noctalia-desktop-widget-"
}

// ─── System & Security Layers ───
layer-rule {
    match namespace="^notifications$"
    match namespace="^noctalia-notification.*$"
    block-out-from "screen-capture"
}

// General UI blur for menus and bars.
layer-rule {
    match layer="top"
    match layer="overlay"
    
    popups {
        geometry-corner-radius 12
        background-effect {
            blur true
            xray false
        }
    }
}

