[Unit]
Description=Rclone Mount for GDrive Full
AssertPathIsDirectory=/mnt/GoogleDrive
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
Restart=always
RestartSec=10
TimeoutStopSec=30
LimitNOFILE=102400
Environment=RCLONE_CONFIG=/home/melih/.config/rclone/rclone.conf

ExecStart=/usr/bin/rclone mount gdrive:/ /mnt/GoogleDrive \
     --allow-other \
     --umask 002 \
     --dir-cache-time 1000h \
     --poll-interval 15s \
     --drive-pacer-min-sleep 10ms \
     --drive-pacer-burst 200 \
     --vfs-cache-mode full \
     --vfs-cache-max-size 50G \
     --vfs-cache-max-age 24h \
     --vfs-read-chunk-size 64M \
     --vfs-read-chunk-size-limit 4G \
     --vfs-read-ahead 256M \
     --vfs-fast-fingerprint \
     --drive-chunk-size 128M \
     --vfs-write-back 10s \
     --buffer-size 128M \
     --timeout 1h \
     --transfers 4 \
     --log-level NOTICE \
     --log-file /home/melih/logs/rclone-gdrive.log \
     --rc --rc-addr=localhost:5572

ExecStop=-/usr/bin/fusermount3 -uz /mnt/GoogleDrive

[Install]
WantedBy=default.target
